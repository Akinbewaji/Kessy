# ==========================================
# AI API KEYS (Backend server settings)
# ==========================================
GROQ_API_KEY="your_groq_api_key_here"
STABILITY_API_KEY="your_stability_api_key_here"

# ==========================================
# FIREBASE CONFIGURATION (Vite frontend)
# ==========================================
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your_project_id-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# ==========================================
# PAYMENT GATEWAY (Paystack settings)
# ==========================================
VITE_PAYSTACK_PUBLIC_KEY="your_paystack_public_key_here"

# ==========================================
# EMAIL & SYSTEM SETTINGS
# ==========================================
# For SMTP_PASS, generate an App Password from your Google Account (Security -> 2-Step Verification -> App Passwords)
